+static int sk_mul_size(size_t a, size_t b, size_t c, size_t* out)
+{
+  size_t t;
+  if (a != 0 && b > SIZE_MAX / a) { return -1; }
+  t = a * b;
+  if (t != 0 && c > SIZE_MAX / t) { return -1; }
+  *out = t * c;
+  return 0;
