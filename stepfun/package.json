{
  "name": "seekdb-browser-kb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-local embeddings + seekdb hybrid retrieval mini knowledge base",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "serve": "npm run build && node server/index.mjs",
    "model:fetch": "node scripts/fetch-model.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "seekdb": "1.4.0"
  },
  "devDependencies": {
    "playwright-core": "^1.51.0",
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
